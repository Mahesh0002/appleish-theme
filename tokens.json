{
  "meta": {
    "name": "Appleish",
    "version": "0.1.0"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "huge": 48,
    "section": 64
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24,
    "pill": 9999
  },
  "typography": {
    "caption": { "size": 11, "weight": 400, "line_height": 1.33 },
    "footnote": { "size": 13, "weight": 400, "line_height": 1.38 },
    "body": { "size": 15, "weight": 400, "line_height": 1.47 },
    "body_emphasis": { "size": 15, "weight": 600, "line_height": 1.47 },
    "callout": { "size": 17, "weight": 500, "line_height": 1.41 },
    "title3": { "size": 20, "weight": 600, "line_height": 1.40 },
    "title2": { "size": 24, "weight": 600, "line_height": 1.33 },
    "title1": { "size": 28, "weight": 700, "line_height": 1.28 },
    "large_title": { "size": 34, "weight": 700, "line_height": 1.20 },
    "control": { "size": 13, "weight": 500, "line_height": 1.0 },
    "tabular": { "size": 13, "weight": 400, "line_height": 1.0, "font_features": "tnum" }
  },
  "font_families": [
    "SF Pro Text",
    "SF Pro Display",
    "Inter",
    "Adwaita Sans",
    "Noto Sans",
    "sans-serif"
  ],
  "colors": {
    "dark": {
      "canvas": "#16161a",
      "card": "#1f1f24",
      "card_elevated": "#2a2a31",
      "control": "rgba(255,255,255,0.06)",
      "control_hover": "rgba(255,255,255,0.12)",
      "control_pressed": "rgba(255,255,255,0.18)",
      "separator": "rgba(255,255,255,0.08)",
      "focus_ring": "#0a84ff",
      "label": "#ffffff",
      "label_secondary": "rgba(255,255,255,0.78)",
      "label_tertiary": "rgba(255,255,255,0.55)",
      "label_quaternary": "rgba(255,255,255,0.38)",
      "link": "#0088ff",
      "accent": "#0077cc",
      "accent_hover": "#3f97ff",
      "destructive": "#d93025",
      "success": "#32d74b",
      "warning": "#ff9f0a",
      "selection_wash": "rgba(0,119,204,0.16)",
      "shadow": "rgba(0,0,0,0.35)",
      "shadow_strong": "rgba(0,0,0,0.55)"
    },
    "light": {
      "canvas": "#f5f5f7",
      "card": "#ffffff",
      "card_elevated": "#ffffff",
      "control": "rgba(0,0,0,0.05)",
      "control_hover": "rgba(0,0,0,0.08)",
      "control_pressed": "rgba(0,0,0,0.13)",
      "separator": "rgba(0,0,0,0.10)",
      "focus_ring": "#007aff",
      "label": "#1d1d1f",
      "label_secondary": "rgba(0,0,0,0.72)",
      "label_tertiary": "rgba(0,0,0,0.50)",
      "label_quaternary": "rgba(0,0,0,0.35)",
      "link": "#0060cc",
      "accent": "#0060cc",
      "accent_hover": "#0052a3",
      "destructive": "#d70015",
      "success": "#28a745",
      "warning": "#c9740a",
      "selection_wash": "rgba(0,96,204,0.14)",
      "shadow": "rgba(0,0,0,0.14)",
      "shadow_strong": "rgba(0,0,0,0.22)"
    }
  },
  "motion": {
    "fast": "120ms ease-out",
    "base": "180ms ease-in-out",
    "slow": "260ms ease-in-out",
    "retint": "350ms ease-in-out"
  },
  "elevation": {
    "card": "0px 2px 8px {shadow}",
    "popover": "0px 8px 24px {shadow_strong}",
    "floating": "0px 4px 14px {shadow}"
  }
}
